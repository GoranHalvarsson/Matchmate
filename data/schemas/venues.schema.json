{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matchmate venues contracts v0.3.0",
  "$defs": {
    "stadium": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "stadium"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "time_zone": {
              "type": "string",
              "minLength": 1
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "capacity": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "address": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/address"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "time_zone",
            "latitude",
            "longitude",
            "capacity",
            "address"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "club_stadium": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "club_stadium"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "club_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "club"
            },
            "stadium_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "stadium"
            },
            "use": {
              "type": "string",
              "enum": [
                "home",
                "temporary_home",
                "training"
              ]
            }
          },
          "required": [
            "club_id",
            "stadium_id",
            "use"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "pitch": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "pitch"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "stadium_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "stadium"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "stadium_id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "pitch_configuration": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "pitch_configuration"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "pitch_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "pitch"
            },
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "surface": {
              "type": "string",
              "enum": [
                "grass",
                "hybrid",
                "artificial",
                "unknown"
              ]
            },
            "positive_x_bearing_degrees": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                {
                  "type": "null"
                }
              ]
            },
            "coordinate_origin": {
              "const": "fixed_corner"
            }
          },
          "required": [
            "pitch_id",
            "length_m",
            "width_m",
            "surface",
            "positive_x_bearing_degrees",
            "coordinate_origin"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
