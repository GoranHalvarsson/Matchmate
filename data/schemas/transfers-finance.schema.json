{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matchmate transfers-finance contracts v0.3.0",
  "$defs": {
    "transfer": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "transfer"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "person_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "person"
            },
            "from_club_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "x-reference": "club"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to_club_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "club"
            },
            "transfer_type": {
              "type": "string",
              "enum": [
                "permanent",
                "loan",
                "free",
                "loan_return"
              ]
            },
            "announced_at": {
              "$ref": "common.schema.json#/$defs/valid_to"
            },
            "effective_at": {
              "$ref": "common.schema.json#/$defs/valid_from"
            },
            "registered_at": {
              "$ref": "common.schema.json#/$defs/valid_to"
            }
          },
          "required": [
            "person_id",
            "from_club_id",
            "to_club_id",
            "transfer_type",
            "announced_at",
            "effective_at",
            "registered_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "financial_term": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "financial_term"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transfer_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "transfer"
            },
            "component": {
              "type": "string",
              "enum": [
                "guaranteed_fee",
                "conditional_add_on",
                "loan_fee",
                "purchase_option",
                "purchase_obligation",
                "sell_on"
              ]
            },
            "disclosure": {
              "type": "string",
              "enum": [
                "confirmed",
                "reported",
                "undisclosed"
              ]
            },
            "money": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/money"
                },
                {
                  "type": "null"
                }
              ]
            },
            "percentage": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "condition": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "transfer_id",
            "component",
            "disclosure",
            "money",
            "percentage",
            "condition"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "disclosure": {
                    "const": "undisclosed"
                  }
                }
              },
              "then": {
                "properties": {
                  "money": {
                    "type": "null"
                  },
                  "percentage": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "payment": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "payment"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "financial_term_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "financial_term"
            },
            "status": {
              "type": "string",
              "enum": [
                "scheduled",
                "paid"
              ]
            },
            "at": {
              "$ref": "common.schema.json#/$defs/valid_from"
            },
            "money": {
              "$ref": "common.schema.json#/$defs/money"
            }
          },
          "required": [
            "financial_term_id",
            "status",
            "at",
            "money"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
