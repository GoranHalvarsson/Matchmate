{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matchmate tracking contracts v0.3.0",
  "$defs": {
    "tracking_sample": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "tracking_sample"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "fixture"
            },
            "clock": {
              "$ref": "common.schema.json#/$defs/clock"
            },
            "pitch_configuration_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "pitch_configuration"
            },
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "person"
                    },
                    "person_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$",
                      "x-reference": "person"
                    }
                  },
                  "required": [
                    "type",
                    "person_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "active_ball"
                    },
                    "physical_ball_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]*$",
                          "x-reference": "physical_ball"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "physical_ball_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "position": {
              "$ref": "common.schema.json#/$defs/position"
            },
            "method": {
              "type": "string",
              "enum": [
                "observed",
                "estimated",
                "synthetic"
              ]
            },
            "quality": {
              "type": "string",
              "enum": [
                "usable",
                "uncertain",
                "invalid"
              ]
            }
          },
          "required": [
            "fixture_id",
            "clock",
            "pitch_configuration_id",
            "subject",
            "position",
            "method",
            "quality"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
