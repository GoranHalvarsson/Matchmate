{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matchmate balls contracts v0.3.0",
  "$defs": {
    "ball_model": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "ball_model"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "manufacturer": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "edition": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "manufacturer",
            "model",
            "edition"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "physical_ball": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "physical_ball"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "ball_model_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "ball_model"
            },
            "identifier": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ball_model_id",
            "identifier"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ball_use": {
      "type": "object",
      "properties": {
        "record_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "revision_id": {
          "$ref": "common.schema.json#/$defs/record_id"
        },
        "supersedes_revision_id": {
          "$ref": "common.schema.json#/$defs/supersedes_revision_id"
        },
        "kind": {
          "const": "ball_use"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/source_id"
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/provenance"
        },
        "claim_status": {
          "$ref": "common.schema.json#/$defs/claim_status"
        },
        "valid_from": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "valid_to": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/valid_from"
        },
        "published_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "synthetic_released_at": {
          "$ref": "common.schema.json#/$defs/valid_to"
        },
        "payload": {
          "type": "object",
          "properties": {
            "fixture_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "fixture"
            },
            "ball_model_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "x-reference": "ball_model"
            },
            "physical_ball_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "x-reference": "physical_ball"
                },
                {
                  "type": "null"
                }
              ]
            },
            "start": {
              "$ref": "common.schema.json#/$defs/clock"
            },
            "end": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/clock"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "initial",
                "routine_swap",
                "damaged",
                "pressure",
                "unknown"
              ]
            }
          },
          "required": [
            "fixture_id",
            "ball_model_id",
            "physical_ball_id",
            "start",
            "end",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "supersedes_revision_id",
        "kind",
        "source_id",
        "provenance",
        "claim_status",
        "valid_from",
        "valid_to",
        "recorded_at",
        "published_at",
        "synthetic_released_at",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "synthetic"
              }
            }
          },
          "then": {
            "properties": {
              "synthetic_released_at": {
                "$ref": "common.schema.json#/$defs/valid_from"
              },
              "claim_status": {
                "const": "authored"
              }
            }
          },
          "else": {
            "properties": {
              "synthetic_released_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
