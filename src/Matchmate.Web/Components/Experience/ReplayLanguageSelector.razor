@using Matchmate.Web.Localization
@using Matchmate.Web.Experience
@inject MatchLanguageState State
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable
<div class="replay-language" lang="@MatchLanguages.Code(State.Language)" aria-busy="@_saving"
     data-standalone-language="@(Standalone ? "" : null)" data-language-save-failed="@(Standalone ? ShellText.Get(State.Language, "LanguageSaveFailed") : null)">
    <label class="language-label" for="matchmate-language">@ShellText.Get(State.Language, "LanguageLabel")</label>
    <svg class="language-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 6.5h14M5 17.5h14" /></svg>
    <select id="matchmate-language" value="@State.Language" @onchange="ChangeAsync" disabled="@(!_ready || _saving)">
        @foreach (var language in MatchLanguages.Supported)
        {
            <option value="@language" lang="@MatchLanguages.Code(language)" data-culture="@(Standalone ? MatchLanguages.Culture(language).Name : null)" selected="@(Standalone && language == State.Language)">@MatchLanguages.Name(language)</option>
        }
    </select>
    <svg class="language-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" /></svg>
    @if (Standalone) { <span class="language-error" role="status" data-language-error hidden></span> }
    else if (_saveFailed) { <span class="language-error" role="status">@ShellText.Get(State.Language, "LanguageSaveFailed")</span> }
</div>
@code {
    [Parameter] public bool Standalone { get; set; }
    private LanguagePreferenceInterop? _interop;
    private bool _ready, _saving, _saveFailed, _disposed;
    protected override void OnInitialized() => State.Changed += LanguageChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Standalone) return;
        _interop = new LanguagePreferenceInterop(JS);
        try
        {
            if (!State.BrowserPreferenceReconciled)
            {
                var language = await _interop.InitializeAsync(State.Language);
                if (_disposed) return;
                State.ReconcileBrowserPreference(language);
            }
            else await _interop.UpdateDocumentAsync(State.Language);
            if (_disposed) return;
            _ready = true;
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            if (_disposed) return;
            _saveFailed = true;
            StateHasChanged();
        }
    }
    private async Task ChangeAsync(ChangeEventArgs args)
    {
        if (!_ready || _saving || _disposed || _interop is null || !Enum.TryParse<MatchLanguage>(args.Value?.ToString(), out var language)
            || !Enum.IsDefined(language) || language == State.Language) return;
        _saving = true; _saveFailed = false;
        var currentUri = Navigation.Uri;
        try
        {
            var result = await _interop.SaveAsync(language);
            if (!result.Saved) { _saveFailed = true; return; }
            if (_disposed) return;
            State.SetLanguage(language);
            if ((result.RefreshNotFound || ShellText.RequiresPageRefresh(currentUri)) && Navigation.Uri == currentUri) Navigation.Refresh(forceReload: true);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { _saveFailed = true; }
        finally { _saving = false; }
    }
    private async void LanguageChanged()
    {
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
        catch (Exception exception) { await DispatchExceptionAsync(exception); }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        State.Changed -= LanguageChanged;
        if (_interop is not null) await _interop.DisposeAsync();
    }
}
