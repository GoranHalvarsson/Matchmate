@using Matchmate.Web.Localization
@using Matchmate.Contracts
@using Matchmate.Core
@using Matchmate.Web.Experience
<g class="event-annotation" aria-label="@T("SchematicLabel")">
@if (Presentation is { Path.Length: > 0 } plan) { <polyline class="sequence-path" points="@string.Join(" ", plan.Path.Select(p => $"{N(p.X + 6)},{N(p.Y + 6)}"))"/> }
@foreach (var scene in Scenes) {
<g data-sequence-id="@scene.Sequence.Id">
@foreach (var step in scene.Sequence.Steps) {
<g data-step-id="@step.Id" data-step-kind="@step.Kind">
@if (Presentation is { Contact: { } point, ActiveStep: { } active } && active == step) {
    @if (step.Kind == "corner") { <path class="corner-arc" d="@($"M{N(point.X + 6)} {N(point.Y + 6)}v3m0 -3h{(point.X < Dataset.Fixture!.Pitch.LengthM / 2 ? "3" : "-3")}")"/> }
    @if (step.Kind is "headed_assist" or "header_finish") { <circle class="head-contact" cx="@N(point.X + 6)" cy="@N(point.Y + 4)" r=".65"/> }
    @if (step.Kind == "uncertain_goalmouth") { <circle class="unknown-contact" cx="@N(point.X + 6)" cy="@N(point.Y + 6)" r="1.2"/> }
}
@if (step.Kind is "booking" or "substitution") {
    var person = step.RelatedActorId ?? step.ActorId; var position = Presentation?.Frame?.Players.FirstOrDefault(p => p.SubjectId == person && p.Availability == "present");
    @if (position is not null) {
        @if (step.Kind == "booking") { <rect class="booking" x="@N(position.XM!.Value + 8)" y="@N(position.YM!.Value + 3)" width="1.2" height="1.8" rx=".15"/> }
        else { <path class="change" d="@($"M{N(position.XM!.Value + 8)} {N(position.YM!.Value + 4)}h3m-1 -1l1 1l-1 1")"/> }
    }
}
</g> }
</g> }
</g>
@code {
    [CascadingParameter] public MatchLanguage Language { get; set; }
    private string T(string key, params object?[] args) => ReplayText.Get(Language, key, args);
    [Parameter, EditorRequired] public MatchSequenceProjection[] Scenes { get; set; } = [];
    [Parameter, EditorRequired] public FootballDataset Dataset { get; set; } = default!;
    [Parameter] public MatchPitchPresentation? Presentation { get; set; }
    private static string N(double value) => ExperiencePresentation.Number(value);
    public static string Label(string kind) => MatchPitchPresenter.Label(kind);
}
