@using Matchmate.Web.Localization
@using Matchmate.Contracts
@using Matchmate.Web.Experience
<div class="recent-results">@if (Matches.Count == 0) { <p>@T("NoEarlierResults")</p> }
@foreach (var match in Matches) { <a @key="match.MatchKey" href="@ExperiencePresentation.MatchUrl(Season, match.MatchKey, DateIndex ?? 0, SelectedClub)"><small>@ExperiencePresentation.Date(match.Date, Language)</small><span>@Name(match.Home) <strong>@match.HomeGoals–@match.AwayGoals</strong> @Name(match.Away)</span></a> }</div>
@code {
    [CascadingParameter] public MatchLanguage Language { get; set; }
    private string T(string key, params object?[] args) => LeagueText.Get(Language, key, args);
    [Parameter] public IReadOnlyList<LeagueMatch> Matches { get; set; } = [];
    [Parameter] public IReadOnlyList<LeagueClub> Clubs { get; set; } = [];
    [Parameter] public string Season { get; set; } = "";
    [Parameter] public int? DateIndex { get; set; }
    [Parameter] public string? SelectedClub { get; set; }
    private string Name(string id) => Clubs.FirstOrDefault(c => c.Id == id)?.Name ?? id;
}
