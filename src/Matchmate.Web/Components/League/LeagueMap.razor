@using Matchmate.Web.Localization
@using Matchmate.Contracts
@using Matchmate.Web.Experience
<section class="map-panel"><div class="map-panel-heading"><span class="eyebrow">@T("FootballInPlace")</span><span>@T("ChooseCrest")</span></div><svg class="league-map" viewBox="120 30 640 710" aria-labelledby="map-title map-desc" role="group"><title id="map-title">@T("MapTitle")</title><desc id="map-desc">@T("MapDescription")</desc><defs><pattern id="sea-lines" width="18" height="18" patternUnits="userSpaceOnUse"><path d="M0 17H18" stroke="#dbded3" stroke-width=".4"/></pattern><filter id="land-shadow"><feDropShadow dx="0" dy="5" stdDeviation="6" flood-color="#253f31" flood-opacity=".08"/></filter></defs><rect x="120" y="30" width="640" height="710" fill="url(#sea-lines)"/><g class="land" filter="url(#land-shadow)"><path d="M371 59 C359 66 346 62 337 77 L326 77 330 92 313 102 320 115 305 127 310 143 295 157 302 170 290 184 308 191 300 207 316 217 311 235 326 242 320 258 337 269 334 283 352 293 359 311 376 320 379 340 367 359 375 378 367 398 371 418 355 433 352 450 338 455 345 472 332 482 343 497 331 507 316 501 309 515 294 513 297 530 283 542 300 548 302 566 288 576 274 578 279 591 299 599 315 596 326 610 346 607 353 620 369 619 365 638 350 645 345 658 329 660 320 673 307 672 302 689 286 692 281 704 258 709 250 721 272 719 290 710 311 713 328 702 349 706 367 694 389 698 407 688 426 693 444 681 466 686 487 675 505 678 518 664 539 661 554 650 546 640 529 640 525 625 536 614 530 601 546 590 553 572 545 548 525 538 504 541 491 531 488 512 476 497 482 478 477 458 485 443 477 427 477 410 464 397 466 376 455 361 456 340 442 323 437 303 420 291 409 273 397 268 390 253 402 246 410 231 420 220 421 200 438 190 447 171 438 159 416 165 402 155 411 145 431 138 440 122 427 117 410 127 397 116 405 105 422 99 430 83 409 85 391 76 380 79 Z"/>
  <path d="M231 327l-24 3-16 14-20 2-11 21 7 21 21 6 11 18 24-4 11-16 22-2 6-20-13-14 1-19z"/>
  <path d="M292 91l-8 19 7 14-11 16 8 16 9-13-2-20 9-15zM278 165l-7 13 5 17 9-8zM273 205l-6 15 8 10 8-14zM449 51l-13 8 4 11 17-3 5-13zM478 35l-10 9 8 8 12-7z"/></g>
  <g class="map-region" aria-hidden="true"><text x="350" y="184" transform="rotate(-12 350 184)">@T("Scotland")</text><text x="193" y="362" text-anchor="middle">@T("Northern")</text><text x="193" y="376" text-anchor="middle">@T("Ireland")</text><text x="315" y="566" transform="rotate(-22 315 566)">@T("Wales")</text><text x="432" y="600" transform="rotate(12 432 600)">@T("England")</text><text x="176" y="513" class="sea-name" transform="rotate(-14 176 513)">@T("IrishSea")</text><text x="587" y="181" class="sea-name">@T("NorthSea")</text></g>
  <path class="london-leader" d="M495 635Q568 638 576 565"/><circle cx="495" cy="635" r="7" class="london-dot"/><text class="map-caption" x="494" y="659">@T("LondonLink")</text><rect class="london-inset" x="550" y="320" width="192" height="253" rx="22"/><text class="inset-label" x="570" y="345">@T("LondonWatford")</text><path class="thames" d="M562 486q35-28 58-8t44-1 63 9"/><g id="club-map-markers">
@foreach (var club in Snapshot.Clubs) {
var row = Snapshot.Rows.First(r => r.Id == club.Id);
<g @key="club.Id" class="map-marker @(Selected == club.Id ? "selected" : "")" transform="@($"translate({ExperiencePresentation.Number(club.X)} {ExperiencePresentation.Number(club.Y)})")" role="button" tabindex="0" aria-label="@(club.Name + ", " + club.Ground)" aria-pressed="@(Selected == club.Id)" @onclick="() => Select.InvokeAsync(club.Id)" @onkeydown="e => KeyAsync(e, club.Id)">
<title>@club.Name · @club.Ground</title><circle r="20"/>@if (!_loaded.Contains(club.Id)) { <g><text class="map-initials" text-anchor="middle" y="4">@club.Initials</text></g> }
@if (club.CrestPath is not null && !_failed.Contains(club.Id)) { <image href="@("/" + club.CrestPath.TrimStart('/'))" x="-14" y="-14" width="28" height="28" @onload="() => _loaded.Add(club.Id)" @onerror="() => _failed.Add(club.Id)"/> }
<circle class="rank-disc" cx="18" cy="-17" r="11"/><text class="map-rank" x="18" y="-13" text-anchor="middle">@ExperiencePresentation.Rank(row)</text><text class="map-club-name" y="34" text-anchor="middle">@club.Name</text></g>
}
</g><text x="150" y="719" class="map-caption">@T("MapScale")</text></svg></section>
@code {
    [CascadingParameter] public MatchLanguage Language { get; set; }
    private string T(string key, params object?[] args) => LeagueText.Get(Language, key, args);
[Parameter, EditorRequired] public LeagueSeasonSnapshot Snapshot { get; set; } = default!;
[Parameter] public string? Selected { get; set; }
[Parameter] public EventCallback<string> Select { get; set; }
private readonly HashSet<string> _loaded = [], _failed = [];
private string _season = "";
protected override void OnParametersSet() { if (_season != Snapshot.Season.SeasonKey) { _season = Snapshot.Season.SeasonKey; _loaded.Clear(); _failed.Clear(); } }
private Task KeyAsync(KeyboardEventArgs e, string club) => e.Key is "Enter" or " " ? Select.InvokeAsync(club) : Task.CompletedTask;
}
